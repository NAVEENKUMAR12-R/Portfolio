# ==========================================
# MongoDB Database Configuration
# ==========================================
# 1. Create a free MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas
# 2. Click "Connect" -> "Drivers" -> Copy your connection string
# 3. Paste it below and replace <password> with your database user password:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=PortfolioCluster
MONGODB_DB_NAME=portfolio_db

# Optional Admin Security Secret (to protect write endpoints)
# When set, any saves from Admin Dashboard will include this secret key
ADMIN_SECRET=naveen_super_secret_admin_key_2025

# ==========================================
# Contact Form Access Key (Web3Forms)
# ==========================================
# Free access key from https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=
